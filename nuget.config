<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, so machine-wide extra feeds can't break the build. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <auditSources>
    <clear />
  </auditSources>
</configuration>
